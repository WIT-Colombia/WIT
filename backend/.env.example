# Configuración local de ejemplo; no contiene credenciales reales.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Sustituye USER_PASSWORD por la contraseña local de wit_app en tu entorno.
# No compartas ni confirmes este valor en el chat.
DATABASE_URL="mysql://wit_app:USER_PASSWORD@localhost:3306/wit_dev"

# Genera un valor aleatorio de al menos 32 caracteres y mantenlo solo en backend/.env.
AUTH_ACCESS_TOKEN_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SAMESITE=lax
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# En desarrollo se usa un proveedor simulado; no imprime tokens en logs generales.
EMAIL_MODE=development
EMAIL_FROM=no-reply@wit.local
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
PASSWORD_RESET_URL=http://localhost:5173/reset-password
# Solo para producción con EMAIL_MODE=resend; nunca lo guardes en Git.
# EMAIL_API_KEY=
# EMAIL_API_URL=https://api.resend.com/emails

# Google OAuth (optional until the provider is enabled; keep the secret private).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:5173
