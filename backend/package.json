{
  "name": "@wit/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/shared/email/email-templates.test.ts src/shared/email/resend-email-sender.test.ts src/modules/auth/verification-confirmation.test.ts",
    "prisma:generate": "prisma generate",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.12",
    "mariadb": "^3.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "mariadb": "$mariadb"
  }
}
