{
  "name": "wit-frontend",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:usuario": "npm run dev --workspace=@wit/usuario",
    "dev:negocios": "npm run dev --workspace=@wit/negocios",
    "dev:admin": "npm run dev --workspace=@wit/admin",
    "dev:all": "node scripts/dev-all.mjs",
    "test:e2e": "playwright test",
    "test:e2e:coordinator": "node e2e/coordinator.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:verification": "../backend/node_modules/.bin/tsx --test tests/email-verification.test.ts tests/email-validation.test.ts tests/welcome-navigation.test.ts"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
